# Docker Compose: published application port; optional, defaults to 8080.
# Dokploy should route HTTPS to fleetlog-service:8080.
# Dokploy uses compose.registry.yaml and does not use APP_PORT.
APP_PORT=8080

# Required for the PostgreSQL container. Replace locally; never commit .env.
# In Dokploy, set this in the Environment tab instead of committing a .env file.
# Changing this does NOT change the password of an already initialized volume.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The Go server accepts HTTP_ADDR (default :8080) and STATIC_DIR
# (default web/dist/fleetlog/browser). Docker sets both internally.
# OIDC and S3 are not implemented yet.

# Image downloaded from GHCR; compose.yaml defaults to :main.
# compose.registry.yaml requires this variable explicitly.
# For production, replace :main with a published sha-COMMIT tag.
FLEETLOG_IMAGE=ghcr.io/gustabessa/fleetlog:main

# Exact application origin, without a path. Required in Dokploy production.
# HTTPS enables Secure cookies. Local default is http://localhost:8080.
PUBLIC_URL=http://localhost:8080

# First startup with an empty users table only. No public registration.
# Choose a username and a unique password of 12 to 72 bytes.
# Remove these variables after the first account is created; they do not reset it.
BOOTSTRAP_USERNAME=replace-with-your-username
BOOTSTRAP_PASSWORD=replace-with-a-unique-strong-password

# Compose supplies PGHOST=fleetlog-db, PGPORT=5432, PGDATABASE=fleetlog,
# PGUSER=fleetlog, PGPASSWORD from POSTGRES_PASSWORD and PGSSLMODE=disable
# for the internal Docker connection. For a standalone Go process, supply these
# PG variables yourself, or DATABASE_URL with the connection string.
