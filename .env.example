# Docker Compose: published application port; optional, defaults to 8080.
# Dokploy should route HTTPS to app:8080.
# Dokploy uses compose.dokploy.yaml and does not use APP_PORT.
APP_PORT=8080

# Required for the PostgreSQL container. Replace locally; never commit .env.
# In Dokploy, set this in the Environment tab instead of committing a .env file.
# Changing this does NOT change the password of an already initialized volume.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The Go server accepts HTTP_ADDR (default :8080) and STATIC_DIR
# (default web/dist/fleetlog/browser). Docker sets both internally.
# Database access, OIDC and S3 are not implemented yet; no fictitious settings.
